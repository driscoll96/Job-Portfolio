// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Necessary for Next auth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? // @db.Text
  access_token      String? // @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? // @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  userType   UserType @default(BASIC)
  platforms   String?

  Brands    Brand[]
  Tags      Tag[]
  BrandTags BrandTag[]
  Listings  Listing[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserType {
  CREATOR
  BRAND
  BASIC
}

model Brand {
  id          String     @id @default(cuid())
  name        String
  image       String?
  description String?
  verified    Boolean
  brandTags   BrandTag[]
  createdOn   DateTime
  createdBy   String
  updatedOn   DateTime
  status      String

  user User @relation(fields: [createdBy], references: [id])

  listing Listing[]
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  createdOn DateTime
  createdBy String
  updatedOn DateTime
  status    String

  user User @relation(fields: [createdBy], references: [id])
}

// Do we have have one table that holds all object links or multiple tables to
// Describe each type of link?
model BrandTag {
  id        String   @id @default(cuid())
  brandId   String
  image     String?
  createdOn DateTime
  createdBy String
  updatedOn DateTime
  status    String

  user  User  @relation(fields: [createdBy], references: [id])
  brand Brand @relation(fields: [brandId], references: [id])
}

model Listing {
  id          String   @id @default(cuid())
  name        String
  description String
  requirements String
  brandId     String
  platforms    String
  image       String?
  createdOn   DateTime
  createdBy   String
  updatedOn   DateTime
  updatedBy String
  status      String

  user  User  @relation(fields: [createdBy], references: [id])
  brand Brand @relation(fields: [brandId], references: [id])
}
